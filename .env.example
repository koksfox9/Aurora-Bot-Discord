# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
# Optional: register slash commands only in one server during development.
DISCORD_GUILD_ID=

# Spotify Web API app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3100/auth/spotify/callback

# Lavalink v4 node
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace-with-a-long-random-secret
LAVALINK_SECURE=false
YOUTUBE_REFRESH_TOKEN=

# Optional premium access lists (comma-separated Discord IDs)
PREMIUM_GUILD_IDS=
PREMIUM_USER_IDS=
FREE_QUEUE_LIMIT=50
FREE_COOLDOWN_SECONDS=7
PREMIUM_COOLDOWN_SECONDS=2

# Web panel
WEB_HOST=127.0.0.1
WEB_PORT=3100
# Min. 16 znaków. Puste (albo ta wartość z przykładu) = panel webowy wyłączony.
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEB_PANEL_TOKEN=replace-with-a-random-panel-token

# Runtime data
DATA_DIR=./data

# Playback defaults
DEFAULT_VOLUME=75
