{
  "name": "aurora-music-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord music bot using Lavalink v4, Kazagumo, Spotify metadata, YouTube, radio and a web panel.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "format": "prettier --write src public tests",
    "format:check": "prettier --check src public tests",
    "deploy:commands": "node dist/deployCommands.js",
    "lavalink:up": "docker compose up -d lavalink",
    "lavalink:logs": "docker compose logs -f lavalink",
    "lavalink:down": "docker compose stop lavalink"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "kazagumo": "3.4.3",
    "shoukaku": "4.3.0",
    "socket.io": "4.8.4",
    "youtubei.js": "18.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
